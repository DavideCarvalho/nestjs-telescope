{
  "name": "nestjs-telescope",
  "version": "0.0.0",
  "private": true,
  "description": "Laravel Telescope-style observability console for NestJS — watchers, request correlation, pluggable storage, headless API + optional dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-telescope.git"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "lint": "biome check --max-diagnostics=none .",
    "lint:fix": "biome check --write --max-diagnostics=none .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version && biome check --write --max-diagnostics=none .",
    "release": "pnpm --filter './packages/*' build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@swc/core": "1.16.2",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
