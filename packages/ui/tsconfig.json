{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": [
    "src/app",
    "src/aviary-kit",
    "src/client",
    "src/react",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/*.spec.ts", "**/*.spec.tsx"]
}
