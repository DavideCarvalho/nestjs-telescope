{
  "name": "@dudousxd/nestjs-telescope-ui",
  "version": "1.24.0",
  "description": "Bundled dashboard + composable React components for @dudousxd/nestjs-telescope.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-telescope.git",
    "directory": "packages/ui"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/telescope",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-telescope/issues"
  },
  "keywords": [
    "nestjs",
    "telescope",
    "dashboard",
    "ui",
    "observability",
    "react",
    "tanstack-intent"
  ],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "sideEffects": ["./dist/server/*.js", "**/*.css"],
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react/console": {
      "types": "./dist/react/console.d.ts",
      "import": "./dist/react/console.js",
      "default": "./dist/react/console.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md", "skills"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.lib.json && tsc -p tsconfig.server.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-telescope": "workspace:^",
    "@nestjs/common": ">=11.0.0",
    "@nestjs/core": ">=11.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^9.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0",
    "recharts": "^2.0.0 || ^3.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@dudousxd/nestjs-telescope": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@tanstack/intent": "0.4.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "9.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "18.3.30",
    "@types/react-dom": "18.3.7",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.6",
    "esbuild": "0.21.5",
    "jsdom": "25.0.1",
    "postcss": "8.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4",
    "reflect-metadata": "0.2.2",
    "supertest": "7.2.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
