{
  "name": "@dudousxd/nestjs-telescope-otel",
  "version": "4.0.0",
  "description": "OpenTelemetry for @dudousxd/nestjs-telescope — trace-context provider, a span processor that brings your app's OTel spans into the trace waterfall, Prometheus/OTLP export of recorded entries, and AI-usage and agent-run metrics on the global meter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-telescope.git",
    "directory": "packages/otel"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/telescope",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-telescope/issues"
  },
  "keywords": [
    "nestjs",
    "telescope",
    "opentelemetry",
    "otel",
    "tracing",
    "observability",
    "metrics",
    "prometheus",
    "grafana",
    "ai",
    "agent"
  ],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./span-processor": {
      "types": "./dist/span-processor.d.ts",
      "import": "./dist/span-processor.js",
      "default": "./dist/span-processor.js"
    }
  },
  "files": ["dist/", "grafana/", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-telescope": "workspace:^",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "@opentelemetry/api": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dudousxd/nestjs-telescope": "workspace:*",
    "@nestjs/authorization": "0.1.3",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@types/node": "24.19.2",
    "@types/supertest": "6.0.3",
    "axios": "1.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=24"
  }
}
