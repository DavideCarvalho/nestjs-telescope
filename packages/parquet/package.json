{
  "name": "@dudousxd/nestjs-telescope-parquet",
  "version": "0.0.0",
  "description": "Tiered storage for @dudousxd/nestjs-telescope — a hot StorageProvider plus a cold Parquet tier on S3 or disk, read in pure JS (hyparquet) or optionally DuckDB.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-telescope.git",
    "directory": "packages/parquet"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/telescope",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-telescope/issues"
  },
  "keywords": ["nestjs", "telescope", "parquet", "s3", "storage", "observability"],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "hyparquet": "1.31.5",
    "hyparquet-compressors": "1.1.2",
    "hyparquet-writer": "0.17.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3.0.0",
    "@duckdb/node-api": ">=1.1.0",
    "@dudousxd/nestjs-telescope": "workspace:^",
    "@nestjs/common": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@duckdb/node-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@duckdb/node-api": "1.5.6-r.1",
    "@dudousxd/nestjs-telescope": "workspace:*",
    "@dudousxd/nestjs-telescope-testing": "workspace:*",
    "@nestjs/common": "12.0.3",
    "@types/node": "20.19.43",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "uuid": "11.1.1",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
