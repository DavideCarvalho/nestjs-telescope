{
  "name": "@dudousxd/nestjs-telescope-clickhouse",
  "version": "0.1.0",
  "description": "ClickHouse storage provider for @dudousxd/nestjs-telescope — columnar entries with TTL retention and pre-aggregated rollups.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-telescope.git",
    "directory": "packages/clickhouse"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/telescope",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-telescope/issues"
  },
  "keywords": ["nestjs", "telescope", "clickhouse", "storage", "observability"],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "peerDependencies": {
    "@clickhouse/client": ">=1.0.0",
    "@dudousxd/nestjs-telescope": "workspace:^",
    "@nestjs/common": ">=10.0.0"
  },
  "devDependencies": {
    "@clickhouse/client": "1.24.1",
    "@dudousxd/nestjs-telescope": "workspace:*",
    "@dudousxd/nestjs-telescope-testing": "workspace:*",
    "@nestjs/common": "12.0.3",
    "@types/node": "20.19.43",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
