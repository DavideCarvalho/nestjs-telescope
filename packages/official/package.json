{
  "name": "@dudousxd/nestjs-telescope-official",
  "version": "0.2.0",
  "description": "NestJS first-party integrations for @dudousxd/nestjs-telescope: the official diagnostics_channel events (resilience, workflows, authentication, authorization, mail), @nestjs/ai usage, and @nestjs/observe trace ids.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-telescope.git",
    "directory": "packages/official"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/telescope",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-telescope/issues"
  },
  "keywords": [
    "nestjs",
    "telescope",
    "diagnostics_channel",
    "resilience",
    "workflows",
    "authentication",
    "authorization",
    "mail",
    "ai",
    "observe",
    "observability"
  ],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-telescope": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "@nestjs/ai": ">=0.0.2 <1",
    "@nestjs/authentication": ">=0.1.5 <1",
    "@nestjs/authorization": ">=0.1.3 <1",
    "@nestjs/mail": ">=0.0.2 <1",
    "@nestjs/observe": ">=0.3.20 <1",
    "@nestjs/resilience": ">=0.0.3 <1",
    "@nestjs/workflows": ">=0.0.5 <1"
  },
  "peerDependenciesMeta": {
    "@nestjs/ai": {
      "optional": true
    },
    "@nestjs/authentication": {
      "optional": true
    },
    "@nestjs/authorization": {
      "optional": true
    },
    "@nestjs/mail": {
      "optional": true
    },
    "@nestjs/observe": {
      "optional": true
    },
    "@nestjs/resilience": {
      "optional": true
    },
    "@nestjs/workflows": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dudousxd/nestjs-telescope": "workspace:*",
    "@nestjs/ai": "0.0.2",
    "@nestjs/authentication": "0.1.5",
    "@nestjs/authorization": "0.1.3",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/mail": "0.0.2",
    "@nestjs/observe": "0.3.24",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/resilience": "0.0.3",
    "@nestjs/testing": "12.0.3",
    "@nestjs/workflows": "0.0.5",
    "@types/node": "24.19.2",
    "@types/supertest": "6.0.3",
    "ai": "7.0.163",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=24"
  }
}
