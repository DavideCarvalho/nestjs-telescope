{
  "name": "@dudousxd/nestjs-telescope-mikro-orm-watcher",
  "version": "1.12.1",
  "description": "MikroORM entity lifecycle (model) watcher for @dudousxd/nestjs-telescope.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-telescope.git",
    "directory": "packages/mikro-orm-watcher"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/telescope",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-telescope/issues"
  },
  "keywords": [
    "nestjs",
    "telescope",
    "mikro-orm",
    "model",
    "observability"
  ],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-telescope": "workspace:^",
    "@mikro-orm/core": ">=7.0.0",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "reflect-metadata": ">=0.1.13"
  },
  "peerDependenciesMeta": {
    "@mikro-orm/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dudousxd/nestjs-telescope": "workspace:*",
    "@mikro-orm/core": "7.1.3",
    "@mikro-orm/sqlite": "7.1.3",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@types/node": "20.19.43",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=20"
  }
}
