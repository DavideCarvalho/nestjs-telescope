{
  "name": "@dudousxd/nestjs-telescope-testing",
  "version": "1.13.0",
  "description": "Test utilities for @dudousxd/nestjs-telescope — FakeClock, watcher harness, InMemoryStorageProvider re-export, and the StorageProvider conformance suite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-telescope.git",
    "directory": "packages/testing"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/telescope",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-telescope/issues"
  },
  "keywords": ["nestjs", "telescope", "testing", "observability"],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/storage-conformance.d.ts",
      "import": "./dist/storage-conformance.js",
      "default": "./dist/storage-conformance.js"
    }
  },
  "files": ["dist/", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-telescope": "workspace:^",
    "vitest": ">=2.0.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-telescope": "workspace:*",
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
